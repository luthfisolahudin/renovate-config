{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "pinDigests": true,
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Pinning an existing tag to its digest does not change the version",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node moves along LTS lines only; .node-version is the one pin.",
      "matchManagers": ["nodenv"],
      "matchDepNames": ["node"],
      "versioning": "node",
      "groupName": "Node.js"
    },
    {
      "description": "Group GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Automerge non-major dev dependency updates once CI passes",
      "matchDepTypes": ["devDependencies", "dependency-groups"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Container node images move with .node-version.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "docker.io/library/node"],
      "groupName": "Node.js"
    },
    {
      "description": "devEngines.packageManager and the ghcr.io/pnpm/pnpm image move together.",
      "matchPackageNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Tools pinned in mise.toml (task, betterleaks, ...) move together; Node and pnpm come from .node-version and devEngines.",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true
}
